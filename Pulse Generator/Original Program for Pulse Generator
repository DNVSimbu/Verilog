Program for Pulse Generator which generate Multiple Frequencies Based on FPGA

module pulse_gen (
    input clock,
    input reset,
    input [13:0] switch,
    output reg led_reset,
    output reg [13:0] led,
    output reg [15:0] pulse_out
);

reg [32:0] counter = 0;
reg toggle = 0;

always @(posedge clock or posedge reset) begin
    if (reset) begin
        led_reset <= reset;
        counter <= 0;
        pulse_out <= 0;
        toggle <= 0;
        led <= 0;
    end

    else if (switch[0]) begin          // 62.5 HZ
        led[0] <= switch[0];
        if (counter == 32'd799999) begin
            counter <= 0;
            toggle <= ~toggle;
        end
        else begin
            counter <= counter + 1;
        end
        pulse_out <= {16{toggle}};
    end

    else if (switch[1]) begin           // 125 HZ
        led[1] <= switch[1];
        if (counter == 32'd399999) begin
            counter <= 0;
            toggle <= ~toggle;
        end
        else begin
            counter <= counter + 1;
        end
        pulse_out <= {16{toggle}};
    end

