Optimized Program for Pulse Generator which generate Multiple Frequencies Based on FPGA

module pulse_gen (
    input  wire        clock,
    input  wire        reset,
    input  wire [13:0] switch,
    output reg  [13:0] led,
    output reg  [15:0] pulse_out
);

    reg [31:0] counter;
    reg        toggle;
    reg [31:0] max_count;

    /*--------------------------------------------------
        Frequency selection using case statement
    --------------------------------------------------*/
    always @(*) begin
        case (1'b1)
            switch[0]  : max_count = 32'd400000;   // 62.5 Hz
            switch[1]  : max_count = 32'd200000;   // 125 Hz
            switch[2]  : max_count = 32'd133333;   // 187.5 Hz
            switch[3]  : max_count = 32'd100000;   // 250 Hz
            switch[4]  : max_count = 32'd62500;    // 400 Hz
            switch[5]  : max_count = 32'd50000;    // 500 Hz
            switch[6]  : max_count = 32'd33333;    // 750 Hz
            switch[7]  : max_count = 32'd31250;    // 800 Hz
            switch[8]  : max_count = 32'd25000;    // 1000 Hz
            switch[9]  : max_count = 32'd20833;    // 1200 Hz
            switch[10] : max_count = 32'd15625;    // 1600 Hz
            switch[11] : max_count = 32'd10416;    // 2400 Hz
            switch[12] : max_count = 32'd7812;     // 3200 Hz
            switch[13] : max_count = 32'd5000;     // 5000 Hz
            default    : max_count = 32'd0;
        endcase
    end

    /*--------------------------------------------------
        Counter and toggle logic
    --------------------------------------------------*/
    always @(posedge clock or posedge reset) begin
        if (reset) begin
            counter   <= 0;
            toggle    <= 0;
            pulse_out <= 0;
            led       <= 0;
        end
        else if (max_count != 0) begin
            led <= switch;

            if (counter >= max_count - 1) begin
                counter <= 0;
                toggle  <= ~toggle;
            end
            else begin
                counter <= counter + 1;
            end

            pulse_out <= {16{toggle}};
        end
        else begin
            counter   <= 0;
            toggle    <= 0;
            pulse_out <= 0;
            led       <= 0;
        end
    end

endmodule
